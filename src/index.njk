<section id="hero-simian">
  <div class="container">
    <div class="col-6 text-box">
      <h1>Technology <br> <span>for human beings</span></h1>
      <p>En Simian diseñamos y construimos sitios Web, PWAs, Apps y automatizaciones con IA que conectan marcas con personas.</p>
      <a href="#" class="btn">Agenda una reunión</a>
    </div>
    <div class="col-6 wrap-image">
        <img src="/assets/img/home/hero-dispositivos.png" alt="Desarrollo apps y sitios web" loading="lazy">
    </div>
  </div>
</section>

<section id="portfolio">
  <div class="container">
    {% for proyecto in proyectos %}
      {% include "molecules/card-portafolio.njk" %}
    {% endfor %}
  </div>
  <a href="#" class="btn-more">Todos los proyectos</a>
</section>

