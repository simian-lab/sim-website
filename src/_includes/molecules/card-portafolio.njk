<article class="card-portafolio">
  <div class="image-box">
    <img src="{{ proyecto.imagen }}" alt="{{ proyecto.titulo }}" loading="lazy">
  </div>
  <div class="info">
    <h3>{{ proyecto.titulo }}</h3>
    <p>{{ proyecto.descripcion }}</p>
    {% if proyecto.url %}
      <a href="{{ proyecto.url }}">Ver más</a>
    {% endif %}
  </div>
</article>