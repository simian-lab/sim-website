  <div class="container">
    <div class="wrap-titulo">
      <h2>Soluciones de Simian</h2>
      <p>Diseñamos, automatizamos y escalamos productos digitales de principio a fin.</p>
    </div>

    <div class="grid">
      {% for solucion in soluciones %}
        {% include "molecules/card-solucion.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

